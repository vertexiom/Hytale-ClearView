<Application x:Class="ClearView.Setup.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Surface" Color="#1B2838"/>
  <SolidColorBrush x:Key="Chrome" Color="#151E2A"/>
  <SolidColorBrush x:Key="Foreground" Color="#E6EDF5"/>
  <SolidColorBrush x:Key="Muted" Color="#A8B9CB"/>
  <SolidColorBrush x:Key="Accent" Color="#8DD2F4"/>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="./Fonts/#Inter"/><Setter Property="FontStyle" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource Foreground}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="Button"><Setter Property="FontFamily" Value="./Fonts/#Inter"/><Setter Property="FontStyle" Value="Normal"/>
   <Setter Property="Background" Value="#2A3B4E"/><Setter Property="Foreground" Value="{StaticResource Foreground}"/>
   <Setter Property="Padding" Value="20,12"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
